# --- Database (Supabase Postgres) ---
# Pooled URL (port 6543, transaction mode) for runtime queries on Vercel/serverless
DATABASE_URL=postgresql://postgres.xxx:[password]@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct URL: use the pooler in SESSION MODE (port 5432) for migrations.
# The Supabase free tier's direct host (db.<ref>.supabase.co) is IPv6-only — use the pooler instead.
DIRECT_URL=postgresql://postgres.xxx:[password]@aws-0-region.pooler.supabase.com:5432/postgres

# --- Auth.js (NextAuth) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- Meta (Facebook + Instagram) ---
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=
META_GRAPH_VERSION=v21.0

# --- Supabase Storage ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=media
